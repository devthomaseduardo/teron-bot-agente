# ── Preferência: use o wizard ──────────────────────────
#   npm run config
# Isso grava config/connections.json + .env

# ── Motor ──────────────────────────────────────────────
# script | hybrid | ai
ENGINE_MODE=hybrid

# NONE | GEMINI | GPT | OLLAMA | DIRECT
AI_SELECTED=GEMINI
ACTIVE_CONNECTION_ID=gemini-free

# ── Nicho ──────────────────────────────────────────────
NICHE_ID=generic
ASSISTANT_NAME=Alex
COMPANY_NAME=Sua Empresa
COMPANY_DESCRIPTION=Descreva sua empresa em uma frase.
SESSION_NAME=assistente
DEVICE_NAME=Agente Comercial
# MENU_URL=https://seu-cardapio.com
# HUMAN_HANDOFF=5511999999999
LEAD_CAPTURE=true
FALLBACK_MESSAGE=Recebi sua mensagem! Em que posso ajudar?

# ── Gemini (grátis) ────────────────────────────────────
GEMINI_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_PROMPT=

# ── OpenAI (paga) ──────────────────────────────────────
OPENAI_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_ASSISTANT=

# ── Ollama (local / grátis) ────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# ── Pagamentos ─────────────────────────────────────────
# Mercado Pago (PIX automático + webhook)
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-... ou TEST-...
# MERCADOPAGO_PUBLIC_KEY=
# MERCADOPAGO_WEBHOOK_SECRET=
# Webhook: https://SEU_DOMINIO/api/payments/webhook/mercadopago
# PIX chave (Nubank/Inter/etc.) configura no painel Admin → Pagamentos

# ── Conexão direta paga (OpenAI-compatible) ────────────
DIRECT_API_KEY=
DIRECT_BASE_URL=https://api.openai.com/v1
DIRECT_MODEL=gpt-4o-mini

# ── Chrome / WPP ───────────────────────────────────────
CHROME_PATH=/usr/bin/google-chrome
