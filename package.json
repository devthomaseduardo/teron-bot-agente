{
  "name": "agente-comercial-whatsapp",
  "version": "2.0.0",
  "description": "Assistente comercial WhatsApp multi-nicho: script + IA, anti-ban, pronto para venda",
  "main": "src/index.ts",
  "bin": {
    "agente": "./dist/cli.cjs"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "build": "tsup src/index.ts src/cli.ts src/panel/server.ts --format cjs --outDir dist",
    "start": "npm run build && node dist/index.cjs",
    "terminal": "tsx src/index.ts",
    "cli": "tsx src/cli.ts",
    "config": "tsx src/cli.ts config",
    "setup": "tsx src/cli.ts config",
    "connections": "tsx src/cli.ts connections",
    "models": "tsx src/cli.ts models",
    "analyze": "tsx src/cli.ts analyze",
    "stats": "tsx src/cli.ts stats",
    "leads": "tsx src/cli.ts leads",
    "doctor": "tsx src/cli.ts doctor",
    "start:pm2": "npm run build && npx pm2 start dist/index.cjs --name agente-comercial",
    "stop": "npx pm2 delete agente-comercial",
    "test:script": "tsx src/scripts/smoke-script.ts",
    "test:barbershop": "tsx src/scripts/test-barbershop.ts",
    "owner": "tsx src/cli.ts owner",
    "dono": "tsx src/cli.ts owner",
    "panel": "tsx src/panel/server.ts",
    "painel": "tsx src/panel/server.ts",
    "admin": "tsx src/panel/server.ts",
    "docker:up": "docker compose up -d --build",
    "docker:logs": "docker compose logs -f agente-barbearia",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "assistente",
    "agente",
    "crm",
    "gemini",
    "wppconnect"
  ],
  "author": {
    "name": "Thomas Eduardo",
    "email": "developer.thomas@outlook.com.br"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.2.1",
    "@wppconnect-team/wppconnect": "^2.2.3",
    "axios": "^1.6.5",
    "csv-stringify": "^6.4.5",
    "dotenv": "^16.3.2",
    "inquirer": "^9.2.15",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "openai": "^4.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.8",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-n": "^15.0.0 || ^16.0.0 ",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-promise": "^6.0.0",
    "pm2": "^5.3.1",
    "prettier": "^3.2.4",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "allowScripts": {
    "puppeteer@24.43.1": true
  }
}
