# ── Preferência: npm run config ──────────────────────────

# ── Motor ──────────────────────────────────────────────
ENGINE_MODE=hybrid
AI_SELECTED=GEMINI
ACTIVE_CONNECTION_ID=gemini-free

# ── Nicho (venda multi-cliente) ────────────────────────
# barbershop | legal | clinic | teron | generic | realestate | restaurant | ecommerce
NICHE_ID=barbershop
ASSISTANT_NAME=Alex
COMPANY_NAME=Sua Empresa
COMPANY_DESCRIPTION=Descreva o negócio em uma frase.
SESSION_NAME=assistente
DEVICE_NAME=Agente Comercial
LEAD_CAPTURE=true
FALLBACK_MESSAGE=Recebi sua mensagem! Digite *menu* para ver as opções.

# Endereço (advogados / presencial)
# BUSINESS_ADDRESS=Rua Exemplo, 100 — Centro

# TERON OS (só se NICHE_ID=teron)
# TERON_OS_URL=https://os.thomaseduardo.com.br

# ── Gemini (recomendado para demo) ─────────────────────
GEMINI_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── OpenAI (opcional) ──────────────────────────────────
OPENAI_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── Ollama (opcional) ──────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# ── Pagamentos ─────────────────────────────────────────
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_PUBLIC_KEY=

# ── Painel (tokens demo prontos) ───────────────────────
PANEL_PORT=8787
PANEL_TOKEN=navalha-dev
ADMIN_TOKEN=admin-dev
PANEL_PUBLIC_URL=http://localhost:8787
# TENANT_ID=

CHROME_PATH=/usr/bin/google-chrome
